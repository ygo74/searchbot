# LibreChat local configuration example.
# Replace every "replace-with-..." value before using this file.

# Server and local services
HOST=localhost
PORT=3080
MONGO_URI=mongodb://127.0.0.1:27017/LibreChat
RAG_API_URL=http://rag_api:8000
DOMAIN_CLIENT=https://localhost
DOMAIN_SERVER=https://localhost
NO_INDEX=true
TRUST_PROXY=1
DEBUG_LOGGING=true
DEBUG_CONSOLE=true
ENDPOINTS=AI Gateway,agents

# AI Gateway and model API credentials
AI_GATEWAY_API_KEY=replace-with-your-ai-gateway-api-key
OPENAI_API_KEY=replace-with-your-openai-api-key
ASSISTANTS_API_KEY=replace-with-your-assistants-api-key

# LibreChat encryption keys: generate a 64-character hex key and a 32-character hex IV
CREDS_KEY=replace-with-a-64-character-hex-key
CREDS_IV=replace-with-a-32-character-hex-iv

# Google Custom Search and Tavily
GOOGLE_SEARCH_API_KEY=replace-with-your-google-search-api-key
GOOGLE_CSE_ID=replace-with-your-google-custom-search-engine-id
TAVILY_API_KEY=replace-with-your-tavily-api-key

# Meilisearch
SEARCH=true
MEILI_NO_ANALYTICS=true
MEILI_HOST=http://0.0.0.0:7700
MEILI_MASTER_KEY=replace-with-a-strong-meilisearch-master-key

# RAG API (use the API key configured for the RAG OpenAI-compatible endpoint)
RAG_OPENAI_BASEURL=http://host.docker.internal:8000/v1
RAG_OPENAI_API_KEY=replace-with-your-rag-api-key
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=text-embedding-3-large

# Authentication and session secrets: use independent, randomly generated values
JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
SESSION_EXPIRY=1000 * 60 * 15
REFRESH_TOKEN_EXPIRY=(1000 * 60 * 60 * 24) * 7

# OpenID Connect / Keycloak
OPENID_CLIENT_ID=librechat
OPENID_CLIENT_SECRET=replace-with-your-openid-client-secret
OPENID_ISSUER=https://keycloak:8443/realms/your-realm/.well-known/openid-configuration
OPENID_SESSION_SECRET=replace-with-a-long-random-openid-session-secret
OPENID_SCOPE="openid profile email"
OPENID_CALLBACK_URL=/oauth/openid/callback
OPENID_REQUIRED_ROLE=admin,user
OPENID_REQUIRED_ROLE_TOKEN_KIND=access
OPENID_REQUIRED_ROLE_PARAMETER_PATH=realm_access.roles
OPENID_ADMIN_ROLE=admin
OPENID_ADMIN_ROLE_PARAMETER_PATH=realm_access.roles
OPENID_ADMIN_ROLE_TOKEN_KIND=access
OPENID_AUTO_REDIRECT=true
OPENID_USE_PKCE=true
OPENID_REUSE_TOKENS=true
OPENID_REUSE_MAX_SESSION_AGE_MS=900000
OPENID_JWKS_URL_CACHE_ENABLED=true
OPENID_JWKS_URL_CACHE_TIME=600000
OPENID_USE_END_SESSION_ENDPOINT=true

# Application behavior
ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=true
ALLOW_SOCIAL_LOGIN=true
ALLOW_SOCIAL_REGISTRATION=false
ALLOW_PASSWORD_RESET=false
ALLOW_UNVERIFIED_EMAIL_LOGIN=true
ALLOW_SHARED_LINKS=true
ALLOW_SHARED_LINKS_PUBLIC=true
APP_TITLE=LibreChat
HELP_AND_FAQ_URL=https://librechat.ai